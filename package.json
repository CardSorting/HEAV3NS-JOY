{
  "name": "heav3ns-joy",
  "version": "1.0.0",
  "license": "MIT",
  "description": "HEAV3NS-JOY: An agnostic, agent-native software development framework for Joyzoning architectural sovereignty.",
  "type": "module",
  "bin": {
    "joy": "./bin/joy.mjs",
    "heav3ns-joy": "./bin/joy.mjs",
    "joy-check": "./bin/joy-check.mjs",
    "docs-check": "./bin/docs-check.mjs",
    "joy-trinity": "./bin/joy-trinity.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "joy-check": "node ./bin/joy-check.mjs .",
    "docs:check": "node ./bin/docs-check.mjs .",
    "verify": "npm test && npm run joy-check && npm run docs:check && npm run plugin:check",
    "trinity:selftest": "node ./bin/joy-trinity.mjs selftest",
    "trinity": "node ./bin/joy-trinity.mjs",
    "trinity:doctor": "node ./bin/joy-trinity.mjs doctor",
    "plugin:build": "node ./scripts/build-plugin.mjs",
    "plugin:check": "node ./scripts/build-plugin.mjs --check"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://github.com/CardSorting/HEAV3NS-JOY#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CardSorting/HEAV3NS-JOY.git"
  },
  "bugs": {
    "url": "https://github.com/CardSorting/HEAV3NS-JOY/issues"
  },
  "keywords": [
    "joyzoning",
    "architecture",
    "ai-agents",
    "agents-md",
    "linter",
    "static-analysis",
    "clean-architecture",
    "broccolidb",
    "broccoliqueue",
    "buffered-db",
    "agent-swarm",
    "zero-dependency",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "agent-skills",
    "agents-md"
  ],
  "files": [
    "bin",
    "src",
    "spec",
    "workflows",
    "configs",
    "templates",
    "docs",
    "examples",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "plugin",
    ".claude-plugin",
    "scripts"
  ],
  "exports": {
    ".": "./src/index.mjs",
    "./portable": "./src/portable.mjs",
    "./broccolidb": "./src/infrastructure/broccolidb/index.mjs",
    "./broccoliqueue": "./src/infrastructure/broccoliqueue/index.mjs"
  }
}
