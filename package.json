{
  "name": "heav3ns-joy",
  "version": "1.0.0",
  "license": "MIT",
  "description": "HEAV3NS-JOY: An agnostic, agent-native software development framework for Joyzoning architectural sovereignty.",
  "type": "module",
  "bin": {
    "joy-check": "./bin/joy-check.mjs",
    "docs-check": "./bin/docs-check.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "joy-check": "node ./bin/joy-check.mjs .",
    "docs:check": "node ./bin/docs-check.mjs .",
    "verify": "npm test && npm run joy-check && npm run docs:check"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://github.com/CardSorting/HEAV3NS-JOY#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CardSorting/HEAV3NS-JOY.git"
  },
  "bugs": {
    "url": "https://github.com/CardSorting/HEAV3NS-JOY/issues"
  },
  "keywords": [
    "joyzoning",
    "architecture",
    "ai-agents",
    "agents-md",
    "linter",
    "static-analysis",
    "clean-architecture"
  ],
  "files": [
    "bin",
    "src",
    "spec",
    "workflows",
    "configs","templates",
    "docs",
    "examples",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.mjs"
  }
}
